# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to version control.

# -------------------------------------------------------
# Backend settings
# -------------------------------------------------------

# Port the FastAPI backend listens on (default: 8000)
BACKEND_PORT=8000

# Path to the SQLite database file
DATABASE_URL=./backend/aaroh_saarthi.db

# -------------------------------------------------------
# Chat assistant (optional)
# -------------------------------------------------------

# Leave blank to use the built-in intent-based assistant.
# Set to a real key only if you want an external LLM.
OPENAI_API_KEY=

# -------------------------------------------------------
# Frontend settings (used by Vite at build time)
# -------------------------------------------------------

# URL of the backend API – change only if you move the server
VITE_API_BASE_URL=http://localhost:8000
