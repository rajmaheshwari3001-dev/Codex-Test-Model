# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to version control.

# -------------------------------------------------------
# Backend settings
# -------------------------------------------------------

# Port the FastAPI backend listens on (default: 8000)
BACKEND_PORT=8000

# Path to the SQLite database file
DATABASE_URL=./backend/aaroh_saarthi.db

# -------------------------------------------------------
# Chat assistant (optional)
# -------------------------------------------------------

# Optional. Use a newly issued xAI API key; never commit its value.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Legacy setting; not used by the current chat service.
OPENAI_API_KEY=

# -------------------------------------------------------
# Frontend settings (used by Vite at build time)
# -------------------------------------------------------

# API prefix including /api (leave unset on Vercel to use same-origin routing)
VITE_API_BASE_URL=http://localhost:8000/api
